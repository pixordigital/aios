# AIOS — Coolify Deployment Environment Variables
# Deploy via Coolify → Raw Compose or Git Repository
# Supabase/PostgreSQL and Redis are added in the Coolify panel (not via compose)
# After deploy: set all vars in Coolify → Service → Environment

# ─── App ───
AIOS_APP_NAME="AIOS"
AIOS_DEBUG=false
AIOS_APP_URL=https://aios.seudominio.com
AIOS_DASHBOARD_ENABLED=true

# ─── Database (Supabase/PostgreSQL via Coolify) ───
# Add PostgreSQL service in Coolify panel → connects at internal host "postgres"
AIOS_DATABASE_URL=postgresql+asyncpg://aios:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/aios
AIOS_DB_BACKEND=sqlalchemy          # sqlalchemy
AIOS_DB_REPLICA_BACKEND=            # failover backend type, empty = no failover
AIOS_DB_AUTO_FAILOVER=true

# ─── Redis via Coolify ───
# Add Redis service in Coolify panel → connects at internal host "redis"
AIOS_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ─── Evolution API (canal WhatsApp) ───
# These MUST be set for inbound WhatsApp. Without them settings.evolution_api_key
# stays "" and every webhook is answered "unknown_instance".
# The compose files inject them into the app as AIOS_EVOLUTION_* (Settings uses
# env_prefix="AIOS_").
EVOLUTION_API_KEY=<chave-evolution>
EVOLUTION_SERVER_URL=http://evolution:8080
EVOLUTION_HOST=evolution.local

# ─── Evolution's own Postgres (docker-compose.yaml) ───
# Required. Use a dedicated role, not the Supabase superuser.
EVOLUTION_DB_USER=aios
EVOLUTION_DB_PASSWORD=CHANGE_ME
EVOLUTION_DB_NAME=evolution

# ─── WhatsApp outbound bubble batching ───
# Texts to the same recipient inside the window are joined into ONE bubble
# (one per-message fee instead of N). Templates/interactive/media never merge.
AIOS_WHATSAPP_BATCH_ENABLED=true
AIOS_WHATSAPP_BATCH_WINDOW_SEC=2.0
AIOS_WHATSAPP_BATCH_MAX_MESSAGES=5
AIOS_WHATSAPP_BATCH_MAX_CHARS=3800

# ─── Channel webhook secrets (all fail closed when unset) ───
AIOS_EVOLUTION_WEBHOOK_SECRET=<segredo>
AIOS_SLACK_SIGNING_SECRET=<segredo>
AIOS_WHATSAPP_APP_ID=<app-id-meta>
AIOS_WHATSAPP_APP_SECRET=<segredo>

# ─── Persistent volume ───
# Must match the volume mount. The image sets this to /data; overriding it to a
# path outside the mount means artifacts and per-agent vector memory are lost on
# every redeploy.
AIOS_APP_DATA_DIR=/data


# ─── Storage (local or S3-compatible, e.g. Supabase Storage) ───
AIOS_STORAGE_BACKEND=local          # local | s3
AIOS_S3_BUCKET=<seu-bucket>
AIOS_S3_REGION=<regiao>
AIOS_S3_ACCESS_KEY=<chave>
AIOS_S3_SECRET_KEY=<segredo>
AIOS_S3_ENDPOINT=https://supabase.storage.com  # for Supabase Storage, R2, MinIO

# ─── LLM Provider Keys ───
AIOS_OPENROUTER_API_KEY=<chave-openrouter>
AIOS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AIOS_OPENAI_API_KEY=<chave-openai>
AIOS_ANTHROPIC_API_KEY=<chave-anthropic>
AIOS_OLLAMA_BASE_URL=http://localhost:11434

# ─── Security ───
# Generate with: openssl rand -hex 32
AIOS_JWT_SECRET=<seu-secreto-hex-32>
AIOS_JWT_ALGORITHM=HS256
AIOS_JWT_EXPIRE_MINUTES=60
AIOS_JWT_REFRESH_EXPIRE_DAYS=30
AIOS_PASSWORD_BCRYPT_ROUNDS=12
AIOS_HTTPS_ONLY=true              # Coolify já fornece SSL Traefik automaticamente
AIOS_CORS_ORIGINS=https://aios.seudominio.com  # comma-separated, defaults to app_url in non-debug
AIOS_RATE_LIMIT_PER_MINUTE=60
AIOS_ADMIN_MASTER_KEY=<chave-frota>
AIOS_REGISTRATION_ENABLED=false   # fechar cadastros beta — home desabilitado quando false
AIOS_LOGIN_ALLOWLIST=pixordigital@gmail.com  # single-operator lockdown: only these
  # comma-separated emails may authenticate (password, dashboard, refresh, OAuth).
  # Empty = any registered user may log in. Enforced at issuance AND on every
  # authenticated request, so removing an address kills its sessions immediately.
AIOS_TOTP_ISSUER=AIOS             # 2FA stub

# ─── Modo interno (ferramenta de times de agentes, não SaaS) ───
AIOS_INTERNAL_MODE=true           # bypass quotas PLANS + gates CRM/billing; tracking continua

# ─── Stripe ───
AIOS_STRIPE_SECRET_KEY=<chave>
AIOS_STRIPE_WEBHOOK_SECRET=<secret>
AIOS_STRIPE_PRICE_STARTER=price_starter
AIOS_STRIPE_PRICE_PRO=price_pro

# ─── Email / SMTP ───
AIOS_SMTP_HOST=smtp.sendgrid.net
AIOS_SMTP_PORT=587
AIOS_SMTP_USER=<usuario>
AIOS_SMTP_PASSWORD=<senha>
AIOS_SMTP_FROM_EMAIL=noreply@aios.seudominio.com

# ─── OAuth (Google) ───
AIOS_GOOGLE_CLIENT_ID=<id>
AIOS_GOOGLE_CLIENT_SECRET=<secret>

# ─── OAuth (GitHub) ───
AIOS_GITHUB_CLIENT_ID=<id>
AIOS_GITHUB_CLIENT_SECRET=<secret>

# ─── Cal.com self-hosted (agendamento SDR) ───
# Infra (docker-compose.coolify.yml: calcom + calcom-api + calcom-db):
#   1. suba o stack e abra https://<CALCOM_HOST>
#   2. crie o usuário admin + org/equipe + 1 event type (ex: "Visita 30min")
#   3. Settings > Security > crie a API key (cal_... teste / cal_live_... prod)
CALCOM_HOST=cal.seudominio.com
CALCOM_DB=calcom
CALCOM_DB_USER=calcom
CALCOM_DB_PASSWORD=<gerar-openssl-rand-hex-32>
CALCOM_NEXTAUTH_SECRET=<gerar-openssl-rand-hex-32>
CALCOM_ENCRYPTION_KEY=<gerar-32-bytes-hex>
CALCOM_JWT_SECRET=<gerar-openssl-rand-hex-32>
# Tool (app → calcom-api na rede interna):
AIOS_CALCOM_API_URL=http://calcom-api:80
AIOS_CALCOM_API_VERSION=2024-08-13
AIOS_CALCOM_API_KEY=<cal_-ou-cal_live_-do-passo-3>
AIOS_CALCOM_EVENT_TYPE_ID=<id-do-event-type-padrao>
AIOS_CALCOM_TIMEZONE=America/Sao_Paulo

# ─── Voz (ElevenLabs ou self-hosted) ───
AIOS_VOICE_PROVIDER=elevenlabs    # elevenlabs | vapi | retell | selfhosted
AIOS_ELEVENLABS_API_KEY=<chave>
AIOS_ELEVENLABS_VOICE_ID=<voice-id>
AIOS_VAPI_API_KEY=<chave>
AIOS_VAPI_ASSISTANT_ID=<id>
AIOS_VAPI_PHONE_NUMBER_ID=<id>
AIOS_RETELL_API_KEY=<chave>
AIOS_RETELL_AGENT_ID=<id>
AIOS_VOICE_TTS_URL=http://voice-tts-kokoro:8880/v1   # Kokoro (serviço Coolify)
# Empty unless you started the opt-in profile:
#   docker compose --profile voice-stt up -d
AIOS_VOICE_STT_URL=
AIOS_VOICE_BRIDGE_URL=              # SIP dial bridge (Twilio/Asterisk)
AIOS_VOICE_FROM_NUMBER=
# Twilio AUTH TOKEN (not an arbitrary secret): X-Twilio-Signature is
# base64(HMAC-SHA1(token, url + sorted POST params)).
AIOS_VOICE_WEBHOOK_SECRET=

# ─── Email inbound parse (optional) ───
# Only Mailgun is supported: its X-Mailgun-Signature is checkable with a shared
# secret. SendGrid needs its app's public key and SES/SNS an RSA key, so both
# refuse loudly rather than accepting something unverified.
AIOS_MAILGUN_WEBHOOK_SECRET=


# ─── WhatsApp / Meta ───
AIOS_WHATSAPP_APP_SECRET=<segredo>

# ─── Observability ───
AIOS_SENTRY_DSN=
AIOS_LOG_FORMAT=json                              # text | json