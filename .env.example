# ─── App ───
AIOS_APP_NAME="AIOS"
AIOS_DEBUG=true
AIOS_APP_URL="http://localhost:8777"
AIOS_DASHBOARD_ENABLED=true

# ─── Database ───
# PostgreSQL (required in production — SQLite refused in non-debug mode)
AIOS_DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/aios"
AIOS_DB_POOL_SIZE=10
AIOS_DB_MAX_OVERFLOW=20
AIOS_DB_BACKEND="sqlalchemy"          # sqlalchemy | convex
AIOS_DB_REPLICA_BACKEND=""            # failover backend type, empty = no failover
AIOS_DB_AUTO_FAILOVER=true

# ─── Convex (optional) ───
AIOS_CONVEX_URL=""
AIOS_CONVEX_ADMIN_KEY=""

# ─── Storage (local or S3-compatible) ───
AIOS_STORAGE_BACKEND="local"          # local | s3
AIOS_S3_BUCKET=""
AIOS_S3_REGION=""
AIOS_S3_ACCESS_KEY=""
AIOS_S3_SECRET_KEY=""
AIOS_S3_ENDPOINT=""                   # for Supabase Storage, R2, MinIO
AIOS_APP_DATA_DIR="./data"

# ─── LLM Provider Keys ───
AIOS_OPENROUTER_API_KEY=""
AIOS_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AIOS_OPENAI_API_KEY=""
AIOS_ANTHROPIC_API_KEY=""
AIOS_OLLAMA_BASE_URL="http://localhost:11434"

# ─── Redis ───
AIOS_REDIS_URL=""                     # e.g. redis://:password@host:6379/0

# ─── Auth / Security ───
# Generate with: openssl rand -hex 32
AIOS_JWT_SECRET=""
AIOS_JWT_ALGORITHM="HS256"
AIOS_JWT_EXPIRE_MINUTES=60
AIOS_JWT_REFRESH_EXPIRE_DAYS=30
AIOS_PASSWORD_BCRYPT_ROUNDS=12
AIOS_HTTPS_ONLY=false
AIOS_CORS_ORIGINS=""                  # comma-separated, defaults to app_url in non-debug
AIOS_RATE_LIMIT_PER_MINUTE=60
AIOS_ADMIN_MASTER_KEY=""              # used for fleet management auth

# ─── Stripe ───
AIOS_STRIPE_SECRET_KEY=""
AIOS_STRIPE_WEBHOOK_SECRET=""
AIOS_STRIPE_PRICE_STARTER=""
AIOS_STRIPE_PRICE_PRO=""

# ─── Email / SMTP ───
AIOS_SMTP_HOST=""
AIOS_SMTP_PORT=587
AIOS_SMTP_USER=""
AIOS_SMTP_PASSWORD=""
AIOS_SMTP_FROM_EMAIL=""

# ─── OAuth (Google) ───
AIOS_GOOGLE_CLIENT_ID=""
AIOS_GOOGLE_CLIENT_SECRET=""

# ─── OAuth (GitHub) ───
AIOS_GITHUB_CLIENT_ID=""
AIOS_GITHUB_CLIENT_SECRET=""

# ─── WhatsApp / Meta ───
AIOS_WHATSAPP_APP_SECRET=""

# ─── Observability ───
AIOS_SENTRY_DSN=""
AIOS_LOG_FORMAT="json"                # text | json
