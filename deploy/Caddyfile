# AIOS reverse proxy — production hardened
# - HTTP IP → HTTPS redirect via Caddy
# - HSTS only on HTTPS
# - Gzip + healthcheck on /health/live (lightweight)
{
	admin off
}

:80 {
	@health path /health/live /health/ready /health
	handle @health {
		reverse_proxy localhost:8777
	}
	redir https://{host}{uri} 308
}

178.105.181.38:443 {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	encode gzip

	request_body max_size 10MB

	@health path /health/live /health/ready /health
	handle @health {
		reverse_proxy localhost:8777 {
			header_up X-Forwarded-Proto https
			health_uri /health/live
			health_interval 15s
			health_timeout 5s
		}
	}

	handle {
		reverse_proxy localhost:8777 {
			header_up X-Forwarded-Proto https
		}
	}

	@websocket {
		header Upgrade websocket
	}
	reverse_proxy @websocket localhost:8777 {
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format json
	}
}
