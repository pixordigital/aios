# Gateway only runs channel pollers once AIOS_RUNTIME_ROLE is implemented
# (Phase 1). Until then it behaves like a second API process on port 8778.
[Unit]
Description=AIOS channel gateway (Telegram long-poll, IMAP)
Wants=network-online.target
After=network-online.target postgresql.service redis-server.service aios-migrate.service
Requires=aios-migrate.service
Documentation=file:/opt/aios/DEPLOY.md

[Service]
Type=simple
User=aios
Group=aios
WorkingDirectory=/opt/aios
EnvironmentFile=/etc/aios/aios.env
Environment=PYTHONUNBUFFERED=1
Environment=AIOS_RUNTIME_ROLE=gateway
StateDirectory=aios
RuntimeDirectory=aios
ExecStart=/opt/aios/.venv/bin/gunicorn aios.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8778 \
    --workers 1 \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
