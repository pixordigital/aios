{
  "title": "AIOS — Observabilidade",
  "uid": "aios-obs",
  "panels": [
    {"title": "Tokens / dia", "targets": [{"expr": "sum by (org) (increase(aios_cost_usd_total[24h]))"}]},
    {"title": "Mensagens / canal", "targets": [{"expr": "sum by (channel) (aios_messages_total)"}]},
    {"title": "Latência p95", "targets": [{"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))"}]},
    {"title": "Erros agente", "targets": [{"expr": "sum by (agent_id) (increase(agent_errors_total[1h]))"}]}
  ]
}
