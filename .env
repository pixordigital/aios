# ─── Database ──────────────────────────────────────────────
# Primary: Supabase PostgreSQL (via Coolify)
AIOS_DATABASE_URL="postgresql+asyncpg://aios:aios_password@supabase-db:5432/aios"
AIOS_DB_BACKEND="sqlalchemy"
# Failover: Convex (optional, set when Convex is configured)
AIOS_DB_REPLICA_BACKEND=""

# ─── Convex (failover backend) ─────────────────────────────
# Set after running: cd convex && npx convex dev --configure=existing
AIOS_CONVEX_URL=""
AIOS_CONVEX_ADMIN_KEY=""

# ─── JWT ───────────────────────────────────────────────────
AIOS_JWT_SECRET="19f5b2736c7b828cb91f44cb5ea1d2a63d846ca5fd85fee4698550933fe1575a"
AIOS_JWT_ALGORITHM="HS256"
AIOS_JWT_EXPIRE_MINUTES=60
AIOS_JWT_REFRESH_EXPIRE_DAYS=30

# ─── Security ──────────────────────────────────────────────
AIOS_ADMIN_MASTER_KEY="b590e15dceb1487a12705e287e220556618e0538fd885b45f50887cbbfef656a"
