# ─── Coolify Deployment — Environment Variables ───
# Copy to .env and fill in values. Never commit .env to git.

# ─── Core ──────────────────────────────────────────────────
AIOS_DEBUG=false
AIOS_APP_NAME="AIOS"
AIOS_APP_URL="https://aios.yourdomain.com"
AIOS_LOG_FORMAT="json"
AIOS_DASHBOARD_ENABLED=true

# ─── Database (Supabase/PostgreSQL) ────────────────────────
# Format: postgresql+asyncpg://user:password@host:5432/dbname
# For Supabase: use their connection pooler URL (port 6543)
AIOS_DATABASE_URL="postgresql+asyncpg://aios:<password>@postgres:5432/aios"
AIOS_DB_BACKEND="sqlalchemy"
AIOS_DB_REPLICA_BACKEND="convex"
AIOS_DB_AUTO_FAILOVER=true

# ─── Convex (Failover Backend) ─────────────────────────────
# Get from: https://convex.dev → your project → Settings
AIOS_CONVEX_URL="https://your-project.convex.cloud"
AIOS_CONVEX_ADMIN_KEY="your-admin-key-here"

# ─── Redis ─────────────────────────────────────────────────
# Internal Docker network: redis://redis:6379
# External Redis: redis://:password@host:6379/0
AIOS_REDIS_URL="redis://redis:6379"

# ─── JWT Auth ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
AIOS_JWT_SECRET="<generate-64-char-hex>"
AIOS_JWT_ALGORITHM="HS256"
AIOS_JWT_EXPIRE_MINUTES=60
AIOS_JWT_REFRESH_EXPIRE_DAYS=30
AIOS_PASSWORD_BCRYPT_ROUNDS=12
AIOS_ADMIN_MASTER_KEY="<generate-64-char-hex>"

# ─── Security ──────────────────────────────────────────────
AIOS_HTTPS_ONLY=true
AIOS_CORS_ORIGINS="https://aios.yourdomain.com"
AIOS_RATE_LIMIT_PER_MINUTE=60

# ─── LLM Providers ─────────────────────────────────────────
AIOS_OPENROUTER_API_KEY="<your-openrouter-key>"
AIOS_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AIOS_OPENAI_API_KEY="<your-openai-key>"
AIOS_ANTHROPIC_API_KEY="<your-anthropic-key>"
AIOS_OLLAMA_BASE_URL="http://localhost:11434"

# ─── Storage (Supabase Storage / S3) ───────────────────────
# Get from: Supabase Dashboard → Storage → Settings
AIOS_STORAGE_BACKEND="s3"
AIOS_S3_ENDPOINT="https://<project-id>.supabase.co/storage/v1/s3"
AIOS_S3_BUCKET="aios-artifacts"
AIOS_S3_REGION="auto"
AIOS_S3_ACCESS_KEY="<supabase-storage-key>"
AIOS_S3_SECRET_KEY="<supabase-storage-secret>"
AIOS_APP_DATA_DIR="./data"

# ─── OAuth (Google) ────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
AIOS_GOOGLE_CLIENT_ID="<google-client-id>.apps.googleusercontent.com"
AIOS_GOOGLE_CLIENT_SECRET="<google-client-secret>"

# ─── OAuth (GitHub) ────────────────────────────────────────
# Get from: https://github.com/settings/developers → OAuth Apps
AIOS_GITHUB_CLIENT_ID="<github-client-id>"
AIOS_GITHUB_CLIENT_SECRET="<github-client-secret>"

# ─── Email / SMTP ──────────────────────────────────────────
# Recommended: Resend (resend.com) or SendGrid
AIOS_SMTP_HOST="smtp.resend.com"
AIOS_SMPT_PORT=587
AIOS_SMTP_USER="resend"
AIOS_SMTP_PASSWORD="<resend-api-key>"
AIOS_SMTP_FROM_EMAIL="noreply@yourdomain.com"

# ─── Stripe Billing ────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
AIOS_STRIPE_SECRET_KEY="sk_live_<your-live-key>"
AIOS_STRIPE_WEBHOOK_SECRET="whsec_<your-webhook-secret>"
AIOS_STRIPE_PRICE_STARTER="price_<starter-price-id>"
AIOS_STRIPE_PRICE_PRO="price_<pro-price-id>"

# ─── WhatsApp / Meta / Zernio ──────────────────────────────
# Meta: https://developers.facebook.com → WhatsApp → Configuration
# Zernio: set same shared secret on the Zernio webhook target config
AIOS_WHATSAPP_APP_SECRET="<meta-app-secret>"
AIOS_ZERNIO_WEBHOOK_SECRET="<zernio-webhook-secret>"

# ─── Observability ─────────────────────────────────────────
# Get from: https://sentry.io → Projects → aios → Client Keys (DSN)
AIOS_SENTRY_DSN="https://<key>@sentry.io/<project-id>"

# ─── Convex Schema Deploy ──────────────────────────────────
# Run after first deploy: cd convex && npx convex deploy
# Or use Convex dashboard: https://convex.dev → your project → Deploy
