# Coolify — cole no painel Service → Environment
AIOS_APP_URL=https://aios.seudominio.com
AIOS_JWT_SECRET= # openssl rand -hex 32
POSTGRES_USER=aios
POSTGRES_PASSWORD= # openssl rand -hex 16
POSTGRES_DB=aios
REDIS_PASSWORD= # openssl rand -hex 16
AIOS_ADMIN_MASTER_KEY=
AIOS_OPENROUTER_API_KEY=
AIOS_OPENAI_API_KEY=
AIOS_ANTHROPIC_API_KEY=
AIOS_STORAGE_BACKEND=local
AIOS_S3_BUCKET=
AIOS_S3_REGION=
AIOS_S3_ACCESS_KEY=
AIOS_S3_SECRET_KEY=
AIOS_S3_ENDPOINT=
AIOS_STRIPE_SECRET_KEY=
AIOS_STRIPE_WEBHOOK_SECRET=
AIOS_SMTP_HOST=
AIOS_SMTP_PASSWORD=
# Voz — Kokoro self-hosted (padrão, sem LiveKit) ou ElevenLabs/Vapi/Retell
AIOS_VOICE_PROVIDER=selfhosted
AIOS_ELEVENLABS_API_KEY=
AIOS_ELEVENLABS_VOICE_ID=
AIOS_VAPI_API_KEY=
AIOS_VAPI_ASSISTANT_ID=
AIOS_VAPI_PHONE_NUMBER_ID=
AIOS_RETELL_API_KEY=
AIOS_RETELL_AGENT_ID=
AIOS_VOICE_TTS_URL=http://voice-tts-kokoro:8880/v1
AIOS_VOICE_STT_URL=http://voice-stt:9000/v1
AIOS_VOICE_BRIDGE_URL=
AIOS_VOICE_FROM_NUMBER=
AIOS_VOICE_WEBHOOK_SECRET= # openssl rand -hex 16
# LiveKit DESABILITADO (VPS 8GB) — deixe vazio
# AIOS_LIVEKIT_URL=ws://livekit:7880
# AIOS_LIVEKIT_API_KEY=devkey
# AIOS_LIVEKIT_API_SECRET= # openssl rand -hex 32
VOICE_TTS_ENGINE=kokoro
VOICE_TTS_VOICE=ptbr  # mapeia para pm_alex (pt) via VOICE_MAP em deploy/voice-stream/agent.py
OLLAMA_MODEL=qwen3:8b
# LLM da voz — ESCOLHA 1 (fácil para usuário): onde o voice-agent pensa
# Opções via OpenRouter/LiteLLM: openai/gpt-4o-mini (rápido/barato), openai/gpt-4o, anthropic/claude-sonnet-4.5, qwen/qwen-3-235b, deepseek/deepseek-v4, ollama/qwen3:8b (local)
AIOS_VOICE_LLM_MODEL=openai/gpt-4o-mini
VOICE_LLM_MODEL=openai/gpt-4o-mini  # alias, mesmo que acima
# Evolution API (desacoplado de 178.105.181.38:6002 → agora integrado)
EVOLUTION_SERVER_URL=http://evolution:8080
EVOLUTION_API_KEY=change-me-evolution-secret
# AIOS_APP_URL deve ser acessível pela Evolution para webhook: https://seu-dominio.com
